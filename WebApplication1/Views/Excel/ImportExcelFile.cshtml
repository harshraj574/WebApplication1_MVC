
@{
    ViewData["Title"] = "ImportExcelFile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <style>
        .input-btn{
            margin-top: 2vh;
        }
    </style>
</head>

<div class="container">
    <div class="row">
        <div class="col-6 offset-3">
            <form method="post" asp-action="ImportExcelFile" asp-controller="Excel" enctype="multipart/form-data">
               <div class="form-group">
                   <label>Upload Excel file</label>
                   <input type="file" name="FormFile" class="form-control" accept=".csv,.xls,.xlsx" />
               </div>
               <input type="submit" class="btn-primary btn btn-sm input-btn" value="upload" />
            </form>
        </div>
    </div>
</div>

