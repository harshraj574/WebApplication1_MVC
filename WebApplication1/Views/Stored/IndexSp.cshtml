@model IEnumerable<WebApplication1.Models.Stored_Proc.Vendor>


<div class="container">
	<div class="row">
		<div class="col-6 offset-3">
			<a asp-controller="Stored" asp-action="Insert_Vendor" class="btn btn-primary m-2">
				<i class="bi bi-plus-circle"></i>  Add New Vendor
			</a>
			<table class="table table-bordered">
				<thread>
					<tr class="text-center">
						<th>Id</th>
						<th>Name</th>
						<th>Gender</th>
						<th>City</th>
						<th>Pincode</th>
						<th>Action</th>
					</tr>
				</thread>
				<tbody>
					@foreach (var d in Model)
					{
						<tr class="text-center">
							<td>@d.Id</td>
							<td>@d.Name</td>
							<td>@d.Gender</td>
							<td>@d.City</td>
							<td>@d.Pincode</td>
							<td>
								<a asp-action="Edit" asp-controller="Stored" asp-route-id="@d.Id" class="btn btn-primary mx-2">
								<i class="bi bi-pencil-square"></i> Edit
							    </a> 
								<a asp-action="Delete" asp-controller="Stored" asp-route-id="@d.Id" class="btn btn-danger mx-2" style="margin-top:10px">
								<i class="bi bi-trash3-fill"></i> Delete
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
